# ─────────────────────────────────────────────────────────────────────────────
# SAGE — environment
#
# Copy to .env.local and fill in. Note the filename: `.env*` is gitignored, so
# this template is deliberately called env.example (no leading dot) in order to
# be committed. It is the only place the full contract is written down.
#
# Only the REQUIRED block is needed to boot. Everything else degrades: a
# missing key disables its feature and says so on the page, rather than
# crashing the app.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────────────────────

# Supabase. Create a project (free tier), run prisma/migrations/0001_init and
# then every file in prisma/sql, and copy these from Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection strings, from Settings → Database. DIRECT_URL bypasses
# the pooler and is what migrations use.
DATABASE_URL=
DIRECT_URL=

# The password for the whole app. There is one user; this is the front door.
# Leave empty ONLY in local development — an empty value disables the gate.
SAGE_PASSWORD=

# Gemini, free tier. Comma-separate several to rotate as each is exhausted.
GOOGLE_GENERATIVE_AI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEYS=key1,key2,key3

# ── WHOSE ASSISTANT THIS IS ──────────────────────────────────────────────────
# Threaded into every system prompt. Set these first when forking.

SAGE_OWNER_NAME=Gyaan
SAGE_HONORIFIC=sir

# NEXT_PUBLIC_ on purpose: the timezone is read by both server code and the
# browser, and Next only inlines NEXT_PUBLIC_* into the client bundle. A plain
# SAGE_TZ would give you your zone on the server and the default in the
# browser — two timezones in one app, which is how day-boundary bugs are born.
# /api/preflight flags it if you set only the private one.
NEXT_PUBLIC_SAGE_TZ=Asia/Kolkata
SAGE_PLACE=Bengaluru
SAGE_LAT=12.9716
SAGE_LON=77.5946
SAGE_EMAIL=
APP_URL=https://your-deployment.vercel.app

# ── SCHEDULED WORK ───────────────────────────────────────────────────────────
# Vercel Hobby allows two crons a day, which cannot run reminders. The
# heartbeat in ops/heartbeat-worker (Cloudflare, free, one-minute granularity)
# calls /api/beat instead. Without it: no reminders, no price alerts, no night
# shift. See docs/OPERATIONS.md.

CRON_SECRET=

# ── SECRETS AT REST ──────────────────────────────────────────────────────────
# API keys added through Settings → Vitals are AES-256-GCM encrypted under this
# before they are stored. It lives here, OUTSIDE the database, so a database
# dump alone is not enough to read them. 32+ random characters. Changing it
# makes every stored key unreadable.

KEY_SECRET=

# ── BACKUP ───────────────────────────────────────────────────────────────────
# owner/repo of a PRIVATE repository. Every table is exported nightly. The
# backup REFUSES to run against a public repo, and key rows are stripped before
# export so live credentials never reach a git history.

BACKUP_REPO=
GITHUB_TOKEN=

# ── OPTIONAL INTEGRATIONS ────────────────────────────────────────────────────
# Each is independent. Absent = that feature is off.

# Google (Gmail, Calendar). OAuth client, redirect: {APP_URL}/api/integrations/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Neural voice, in preference order. Without any of these SAGE falls back to
# the browser's own speech synthesis.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=

# Push notifications. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Markets, news, research, weather — all free tiers.
ALPHAVANTAGE_KEY=
GNEWS_API_KEY=
TAVILY_API_KEY=
OPENWEATHER_API_KEY=
NASA_API_KEY=
NEXT_PUBLIC_TOMTOM_KEY=

# Task mirror, workouts, coding profile, music.
TICKTICK_CLIENT_ID=
TICKTICK_CLIENT_SECRET=
HEVY_API_KEY=
LEETCODE_USERNAME=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Watchlist and morning feeds.
SAGE_STOCKS=RELIANCE.BSE,TCS.BSE
MORNING_YT_CHANNELS=@channelhandle

# ── Local disk bridge (optional) ─────────────────────────────────────────────
# Lets SAGE read folders you choose on your own machine. Its own secret, NOT
# CRON_SECRET: these are different capabilities, and sharing one would mean a
# leak of the weaker hands over the stronger. Unset = the bridge is shut.
#   openssl rand -hex 32
# Then run the daemon on your Mac — see ops/disk-bridge/README.md.
BRIDGE_SECRET=
